# Supabase — project ROOT URL only (Settings → API → Project URL)
# Correct:   https://YOUR_PROJECT_REF.supabase.co
# Wrong:     https://YOUR_PROJECT_REF.supabase.co/rest/v1  ← causes "Invalid path specified in request URL"
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Site URL for auth email redirects (required for production / Vercel)
# Local:  http://127.0.0.1:3000  or  http://localhost:3000
# Vercel: https://your-app.vercel.app  (or leave unset — VERCEL_URL is used automatically)
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
